{
  "author": "Damien Bouissou",
  "authorUrl": "https://github.com/smeet666",
  "description": "MCP server for Pequerecetas. Read Spanish family recipes, rescale them, and browse by diet, ingredient, technique or age.",
  "homepage": "https://github.com/smeet666/mcp-pequerecetas#readme",
  "identifier": "smeet666-mcp-pequerecetas",
  "name": "mcp-pequerecetas",
