  "tools": [
    {
      "name": "get_recipe",
      "title": "Read one recipe",
      "description": "Read one page of the recipe section by the slug in its address, such as 'paella-de-marisco'. 'kind' says what the page turned out to be: a 'recipe', or a 'collection', which is an article gathering other recipes and carries no ingredients of its own. A recipe says under 'source_shape' where its ingredients were read: 'structured' from the block the page publishes for search engines, 'article' from the body of the page, which is where most of this site's recipes keep them. Pass 'servings' to rescale the quantities; a recipe whose page states no number of servings comes back unscaled and says so. A line naming a tool rather than an ingredient is marked and never multiplied.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "The slug in a recipe's address, from search_recipes or browse_recipes."
          },
          "servings": {
            "description": "Rescale the quantities to this many, up to 1000. Left out, the recipe comes back as published.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 1000
          }
        },
        "required": ["id"],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["recipe", "collection"]
          },
          "recipe": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "description": {
                "type": ["string", "null"]
              },
              "published_at": {
                "type": ["string", "null"]
              },
              "modified_at": {
                "type": ["string", "null"]
              },
              "source_shape": {
                "type": "string",
                "enum": ["structured", "article"]
              },
              "yield": {
                "type": "object",
                "properties": {
                  "original_count": {
                    "type": ["number", "null"]
                  },
                  "original_text": {
                    "type": ["string", "null"]
                  },
                  "requested": {
                    "type": ["number", "null"]
                  },
                  "unit": {
                    "type": ["string", "null"]
                  },
                  "factor": {
                    "type": "number"
                  }
                },
                "required": ["original_count", "original_text", "requested", "unit", "factor"],
                "additionalProperties": false
              },
              "ingredients": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "original": {
                      "type": "string"
                    },
                    "scaling": {
                      "type": "string",
                      "enum": ["scaled", "rounded", "unscaled"]
                    },
                    "amount": {
                      "type": ["number", "null"]
                    },
                    "amount_max": {
                      "type": ["number", "null"]
                    },
                    "unit": {
                      "type": ["string", "null"]
                    },
                    "is_heading": {
                      "type": "boolean"
                    },
                    "is_equipment": {
                      "type": "boolean",
                      "description": "True for a line naming a tool rather than something eaten."
                    },
                    "note": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "text",
                    "original",
                    "scaling",
                    "amount",
                    "amount_max",
                    "unit",
                    "is_heading",
                    "is_equipment"
                  ],
                  "additionalProperties": false
                }
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "group": {
                      "description": "The page's own heading for the group this step is under.",
                      "type": ["string", "null"]
                    },
                    "url": {
                      "type": ["string", "null"]
                    },
                    "image": {
                      "type": ["string", "null"]
                    }
                  },
                  "required": ["text", "group", "url", "image"],
                  "additionalProperties": false
                }
              },
              "prep_minutes": {
                "type": ["number", "null"]
              },
              "cook_minutes": {
                "type": ["number", "null"]
              },
              "total_minutes": {
                "type": ["number", "null"]
              },
              "categories": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cuisines": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "author": {
                "type": ["string", "null"]
              },
              "author_url": {
                "type": ["string", "null"]
              },
              "rating": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "number"
                      },
                      "count": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "scale": {
                        "type": "number",
                        "description": "The top of the scale, as published."
                      },
                      "worst": {
                        "type": "number"
                      }
                    },
                    "required": ["value", "count", "scale", "worst"],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "nutrition": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "calories": {
                        "type": ["number", "null"]
                      }
                    },
                    "required": ["text", "calories"],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "images": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "title",
              "url",
              "description",
              "published_at",
              "modified_at",
              "source_shape",
              "yield",
              "ingredients",
              "steps",
              "prep_minutes",
              "cook_minutes",
              "total_minutes",
              "categories",
              "cuisines",
              "keywords",
              "author",
              "author_url",
              "rating",
              "nutrition",
              "images"
            ],
            "additionalProperties": false
          },
          "collection": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "description": {
                "type": ["string", "null"]
              },
              "published_at": {
                "type": ["string", "null"]
              },
              "modified_at": {
                "type": ["string", "null"]
              },
              "headings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "recipes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "image_url": {
                      "type": ["string", "null"]
                    }
                  },
                  "required": ["id", "title", "url", "image_url"],
                  "additionalProperties": false
                }
              },
              "images": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "title",
              "url",
              "description",
              "published_at",
              "modified_at",
              "headings",
              "recipes",
              "images"
            ],
            "additionalProperties": false
          },
          "cached": {
            "type": "boolean"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["kind", "cached", "notes"],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
