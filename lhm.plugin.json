    {
      "name": "search_recipes",
      "title": "Search the recipes",
      "description": "Search Pequerecetas for a dish or an ingredient, in Spanish. The site serves its search on one page and offers no second page, so 'result_count' counts the rows served and 'total_available' is null: the site publishes no count of what a search matched. The rows come in the site's own order, which is not by how well they match, so a dish named in the query can sit well down the page and 'limit' cuts in that order. A row carries the slug that get_recipe takes. Some rows are articles gathering recipes rather than recipes, which get_recipe reports as a 'collection'. To narrow by diet, ingredient, technique or the age of the eater, use list_facets and browse_recipes instead: this site's search takes no filters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "What to search for, in Spanish: a dish, an ingredient, a technique."
          },
          "limit": {
            "description": "Rows to return, at most 60. Left out, every row served comes back.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 60
          }
        },
        "required": ["query"],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The slug get_recipe takes."
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "image_url": {
                  "type": ["string", "null"]
                }
              },
              "required": ["id", "title", "url", "image_url"],
              "additionalProperties": false
            }
          },
          "result_count": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Rows returned."
          },
          "total_available": {
            "type": "null",
            "description": "Always null: the site publishes no count of what a search matched."
          },
          "cached": {
            "type": "boolean"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["query", "results", "result_count", "total_available", "cached", "notes"],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "list_facets",
      "title": "List the taxonomies recipes are browsed by",
      "description": "List the values the site browses its recipes by. The taxonomies are dieta, edad, ingrediente, ocasion, recetas-de, tecnica, tipo-de-cocina, tipo-plato: diet, the age of whoever eats it, main ingredient, occasion, moment of the day, appliance, cuisine and kind of dish. Call this before browse_recipes rather than spelling a value yourself. Pass 'facet' for one taxonomy, or leave it out for all eight, which costs one request per taxonomy.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "facet": {
            "description": "One taxonomy: dieta, edad, ingrediente, ocasion, recetas-de, tecnica, tipo-de-cocina, tipo-plato. All eight when left out.",
            "type": "string",
            "minLength": 1
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "facets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The taxonomy, as browse_recipes takes it."
                },
                "value_count": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Values this taxonomy publishes."
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "string",
                        "description": "The slug browse_recipes takes."
                      },
                      "url": {
                        "type": "string"
                      }
                    },
                    "required": ["value", "url"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["name", "value_count", "values"],
              "additionalProperties": false
            }
          },
          "cached": {
            "type": "boolean"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["facets", "cached", "notes"],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
